# Copy to .env (git-ignored) for local runs. On Render, set these under Environment instead.
# Supabase: Dashboard → Project Settings → API Keys.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The SECRET key (sb_secret_… or the legacy service_role key). Server only — never share or commit it.
SUPABASE_SECRET_KEY=
# Owner-only visits page (/stats): the email(s) of your Nepal Live account, comma-separated.
ADMIN_EMAILS=mainaliroshan202@gmail.com
